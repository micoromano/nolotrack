# ConfigMap "nolotrack-config" — valori NON segreti (si possono committare)
# Dopo una modifica: kubectl apply -k <overlay> (i pod ripartono da soli:
# il nome della ConfigMap cambia con il contenuto).

# Indirizzo pubblico, senza "/" finale — uguale all'host dell'Ingress.
# ⚠ È incorporato anche nell'immagine dell'app (build arg): se cambia, ricostruiscila.
PUBLIC_URL=https://nolotrack.miodominio.it

DISABLE_SIGNUP=true
MAILER_AUTOCONFIRM=false

# SMTP per inviti/reset password (la password va in secrets.env → SMTP_PASS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_SENDER=
SMTP_SENDER_NAME=NoloTrack

# Login con Google (secret in secrets.env → GOOGLE_LOGIN_CLIENT_SECRET)
GOOGLE_LOGIN_ENABLED=false
GOOGLE_LOGIN_CLIENT_ID=

# Email dell'app (password in secrets.env → GMAIL_APP_PASSWORD)
GMAIL_USER=

# Google Calendar (secret in secrets.env → GOOGLE_CLIENT_SECRET)
GOOGLE_CLIENT_ID=

# WhatsApp (token e segreti in secrets.env)
META_WHATSAPP_PHONE_NUMBER_ID=

# Allegati su Cloudflare R2 (chiavi in secrets.env → R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY)
# R2_ENDPOINT solo per altri storage S3-compatibili (es. MinIO)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
