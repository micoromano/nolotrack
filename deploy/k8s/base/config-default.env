# Default della ConfigMap "nolotrack-config" (valori NON segreti).
# Sovrascrivili in overlays/<nome>/config.env — i segreti vanno in secrets.env.
PUBLIC_URL=https://nolotrack.example.com
JWT_EXP=3600
DISABLE_SIGNUP=true
MAILER_AUTOCONFIRM=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_SENDER=
SMTP_SENDER_NAME=NoloTrack
GOOGLE_LOGIN_ENABLED=false
GOOGLE_LOGIN_CLIENT_ID=
GMAIL_USER=
GOOGLE_CLIENT_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
TZ=Europe/Rome
