# =============================================================================
# NoloTrack — configurazione self-hosting (Docker)
# =============================================================================
# 1. cp .env.example .env
# 2. node scripts/genera-env.mjs   (oppure via Docker, vedi INSTALLAZIONE.md)
#    → compila POSTGRES_PASSWORD, JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY
# 3. imposta PUBLIC_URL e le integrazioni che ti servono
# Documentazione completa: docs/self-hosting/CONFIGURAZIONE.md
# NON committare mai il file .env
# =============================================================================

# ── Indirizzo pubblico ───────────────────────────────────────────────────────
# URL con cui utenti e browser raggiungono l'app, SENZA slash finale.
# Locale:        http://localhost:8080
# In produzione: https://nolotrack.tuodominio.it
# ⚠ Se cambia, ricostruisci l'app: docker compose up -d --build
PUBLIC_URL=http://localhost:8080

# Porta e interfaccia su cui il gateway nginx ascolta sul server
HTTP_PORT=8080
HTTP_BIND=0.0.0.0

# Solo con HTTPS automatico (docker compose --profile https up -d)
DOMAIN=

# ── Segreti (generati da scripts/genera-env.mjs) ─────────────────────────────
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXP=3600
ANON_KEY=
SERVICE_ROLE_KEY=

# ── Autenticazione ───────────────────────────────────────────────────────────
# true = solo l'admin crea gli utenti (consigliato)
DISABLE_SIGNUP=true
# true = nessuna email di conferma (utile in test senza SMTP)
MAILER_AUTOCONFIRM=false

# SMTP usato da GoTrue per inviti e reset password (può essere lo stesso Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=
SMTP_SENDER_NAME=NoloTrack

# Login con Google (facoltativo) — redirect URI: ${PUBLIC_URL}/auth/v1/callback
GOOGLE_LOGIN_ENABLED=false
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# ── Email dall'app (pagina Invia) ────────────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Google Maps (autocompletamento indirizzi) — richiede rebuild ─────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Google Calendar (pagina Agenda) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Notifiche push (npx web-push generate-vapid-keys) — pubblica: rebuild ────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── WhatsApp Business (Meta Cloud API) ───────────────────────────────────────
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# ── Sito vetrina pubblico (facoltativi) — richiedono rebuild ─────────────────
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_CITY=
NEXT_PUBLIC_NCC_LICENSE=
NEXT_PUBLIC_WHATSAPP_DISPLAY_NUMBER=
